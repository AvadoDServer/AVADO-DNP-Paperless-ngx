# HTTPS front for Paperless-ngx (generated for this package; app on 127.0.0.1:8000)
user __NGINX_USER__;
worker_processes 2;
pid /tmp/avado-nginx/nginx.pid;
error_log /dev/stderr error;

events {
  worker_connections 1024;
}

http {
  access_log off;
  server_tokens off;
  default_type application/octet-stream;
  client_body_temp_path /tmp/avado-nginx/body;
  proxy_temp_path /tmp/avado-nginx/proxy;
  fastcgi_temp_path /tmp/avado-nginx/fastcgi;
  uwsgi_temp_path /tmp/avado-nginx/uwsgi;
  scgi_temp_path /tmp/avado-nginx/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_certificate     /etc/avado/certs/live.crt;
  ssl_certificate_key /etc/avado/certs/live.key;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_session_cache   shared:avado:2m;

  # Documents and passwords only over HTTPS: plain http goes to the https page.
  server {
    listen 80 default_server;
    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl default_server;
    client_max_body_size 1000m;

    # Paperless needs up to a minute to start (longer after an update): show a
    # plain "starting" page that reloads itself instead of "502 Bad Gateway".
    error_page 502 = @starting;
    location @starting {
      default_type text/html;
      add_header Cache-Control "no-store" always;
      add_header Retry-After 10 always;
      return 503 '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="refresh" content="10"><title>Paperless is starting</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:15vh auto;padding:0 16px;text-align:center;color:#17541f"><h1 style="font-size:1.5rem">Paperless is starting</h1><p>This takes up to a minute, a little longer after an update. This page opens Paperless by itself when it is ready.</p></body></html>';
    }

    location / {
      proxy_pass http://127.0.0.1:8000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      proxy_request_buffering off;
      proxy_buffering off;
    }
  }
}
